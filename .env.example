# ============================================================
# LawSphere Environment Variables — .env.example
# Copy to .env and fill in your values
# ============================================================

# ─── App ────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000
PLATFORM_FEE_PERCENT=10

# ─── Database (Neon Serverless PostgreSQL) ──────────────────
# Get both URLs from: https://console.neon.tech → your project → Connection Details
# "Pooled connection" → DATABASE_URL  (used at runtime via PgBouncer)
# "Direct connection" → DATABASE_URL_UNPOOLED  (used by Prisma migrations only)
DATABASE_URL=postgresql://lawsphere:<password>@ep-xxx-xxx.ap-southeast-1.aws.neon.tech/lawsphere?sslmode=require&pgbouncer=true&connect_timeout=15
DATABASE_URL_UNPOOLED=postgresql://lawsphere:<password>@ep-xxx-xxx.ap-southeast-1.aws.neon.tech/lawsphere?sslmode=require

# ─── Redis ──────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=redis_secret

# ─── Auth (Choose: JWT or Clerk) ────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_EXPIRES_IN=7d

# Clerk (recommended for production)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/register
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ─── AI ─────────────────────────────────────────────────────
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx

# ─── Vector DB (Pinecone) ───────────────────────────────────
PINECONE_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
PINECONE_ENVIRONMENT=us-east-1-aws
PINECONE_INDEX_NAME=lawsphere-lawyers
EMBEDDING_MODEL=text-embedding-3-small

# ─── Storage (AWS S3) ───────────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
S3_BUCKET_DOCUMENTS=lawsphere-documents-prod
S3_BUCKET_MEDIA=lawsphere-media-prod
SIGNED_URL_EXPIRY_SECONDS=3600

# ─── Payments ───────────────────────────────────────────────
# Razorpay (India)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx

# Stripe (International)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Video Consultation (Twilio) ────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Email (Optional) ───────────────────────────────────────
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_xxxxxxxxxxxxxxxx
EMAIL_FROM=noreply@lawsphere.in
